<Project>

  <!-- Central package management: every PackageReference in Proame.sln omits its Version.
       MAUI packages match the installed MAUI workload (10.0.20, manifest band 10.0.100). -->
  <ItemGroup>
    <!-- MAUI head + Blazor Web head -->
    <PackageVersion Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.20" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.15" />

    <!-- UI -->
    <PackageVersion Include="MudBlazor" Version="9.14.0" />

    <!-- Data -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.4" />

    <!-- Tests -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="bunit" Version="2.15.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Moq" Version="4.21.0" />
  </ItemGroup>

</Project>
